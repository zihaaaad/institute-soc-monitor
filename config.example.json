{
  "subnets": {
    "192.168.1.0/24": "Main Lab",
    "192.168.2.0/24": "Software Lab"
  },
  "credentials": {
    "windows_user": "AuditUser",
    "windows_password": "ExampleStrongPassword123"
  },
  "settings": {
    "scan_interval_seconds": 60,
    "metrics_port": 8000,
    "prometheus_port": 9090,
    "grafana_port": 3000
  },
  "asset_whitelist": [
    "00:15:5d:00:00:01",
    "34:5a:60:11:22:33"
  ],
  "alerts": {
    "enabled": false,
    "discord_webhook_url": "https://discord.com/api/webhooks/...",
    "telegram_bot_token": "123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ",
    "telegram_chat_id": "987654321",
    "alert_cooldown_seconds": 300
  },
  "vulnerability_audit": {
    "enabled": true,
    "check_smbv1": true,
    "check_rdp_exposure": true,
    "check_cleartext_http": true,
    "check_rpc_mapper": true
  },
  "wmi_audit": {
    "enabled": true,
    "brute_force_threshold": 5
  },
  "suspicious_processes": [
    "mimikatz.exe",
    "psexec.exe",
    "netcat.exe",
    "nc.exe",
    "nmap.exe",
    "wireshark.exe",
    "tor.exe",
    "anydesk.exe",
    "teamviewer.exe"
  ]
}
